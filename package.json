{
  "name": "secret-broker",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "description": "Agents use secrets by name, never by value: secretrun CLI + Claude Code hook + Infisical backend",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "secretrun": "dist/src/cli.js", "secretrun-hook": "dist/src/hook.js" },
